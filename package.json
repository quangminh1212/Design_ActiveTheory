{
  "name": "design-active-theory",
  "version": "1.0.0",
  "private": true,
  "description": "Bản lưu trữ cấu trúc web Active Theory — HTML entry, UIL config, bundle JS",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build:uil": "node scripts/build-uil.mjs",
    "merge:uil": "node scripts/merge-uil.mjs",
    "validate": "node scripts/validate.mjs",
    "roundtrip": "node scripts/merge-uil.mjs --check",
    "verify:experience": "node scripts/verify-experience.mjs",
    "verify": "pnpm run validate && pnpm run roundtrip && pnpm run verify:experience"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=12.0.0"
  },
  "keywords": [
    "archive",
    "webgl",
    "uil",
    "hydra",
    "active-theory"
  ],
  "packageManager": "pnpm@12.11.2"
}
